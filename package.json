{
  "name": "webbooks-theme-build",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "preflight:node": "node scripts/check-node-version.js",
    "i18n:update": "bash scripts/update-i18n.sh",
    "build": "bash scripts/build-with-fallback.sh",
    "build:local": "vite build",
    "lint": "eslint scripts src vite.config.mjs assets/js/ajax-client.js assets/js/ajax-filter.js assets/js/search-ui.js assets/js/compat-layer.js assets/js/functions.js",
    "ci:build": "npm run preflight:node && npm ci && npm run build:local",
    "release:prepare": "bash scripts/build-release.sh",
    "theme": "bash scripts/theme-release.sh",
    "test:ui": "node --test tests/search-ui.test.cjs"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "jquery": "^3.7.1",
    "jsdom": "^26.1.0",
    "vite": "^8.3.4"
  }
}
