{
  "name": "webbooks-theme-build",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "preflight:node": "node scripts/check-node-version.js",
    "i18n:update": "bash scripts/update-i18n.sh",
    "build": "bash scripts/build-with-fallback.sh",
    "build:local": "vite build",
    "prebuild:local": "node scripts/sync-bootstrap-fallback.mjs",
    "lint": "eslint scripts src vite.config.mjs assets/js/ajax-client.js assets/js/ajax-filter.js assets/js/search-ui.js assets/js/compat-layer.js assets/js/functions.js assets/js/author-support.js",
    "ci:build": "npm run preflight:node && npm ci && npm run build:local",
    "release:prepare": "bash scripts/build-release.sh",
    "theme": "bash scripts/theme-release.sh",
    "test:ui": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "jquery": "^3.7.1",
    "jsdom": "^26.1.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "bootstrap": "5.3.8",
    "clipboard": "^2.0.11",
    "font-awesome": "4.7.0",
    "highlight.js": "^11.11.1",
    "swiper": "14.3.0",
    "typeit": "^8.8.7"
  }
}
